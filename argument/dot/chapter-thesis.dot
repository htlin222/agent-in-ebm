  n13 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#26032;&#31310;&#24615;&#23459;&#31281;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26082;&#26377;&#25991;&#29563;&#34389;&#29702;&#30340;&#26159;&#12300;&#21738;&#20123;&#24037;&#20316;&#21487;&#20197;&#20132;&#32102;&#27231;&#22120;&#12301;，&#26412;&#31456;&#34389;&#29702;&#30340;&#26159;&#12300;&#19968;&#20491;&#27770;&#31574;&#24517;&#38920;&#20197;&#20160;&#40636;&#24418;&#24335;&#23384;<BR/>&#22312;，&#25165;&#31639;&#34987;&#23459;&#21578;&#36942;&#12301;&#12290;</FONT></TD></TR></TABLE>>, tooltip="既有文獻處理的是「哪些工作可以交給機器」，本章處理的是「一個決策必須以什麼形式存在，才算被宣告過」。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n14 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20841;&#20491;&#21839;&#38988;&#19981;&#21516;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20998;&#24037;&#21839;&#38988;&#33287;&#23384;&#22312;&#24418;&#24335;&#21839;&#38988;&#26159;&#20841;&#20491;&#19981;&#21516;&#30340;&#21839;&#38988;，&#24460;&#32773;&#37007;&#36655;&#19978;&#20808;&#26044;&#21069;&#32773;，&#19988;&#26410;&#34987;&#20808;&#39493;&#25991;&#29563;&#34389;&#29702;&#12290;</FONT></TD></TR></TABLE>>, tooltip="分工問題與存在形式問題是兩個不同的問題，後者邏輯上先於前者，且未被先驅文獻處理。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n51 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20808;&#39493;&#25991;&#29563;&#21453;&#39361;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20154;&#27231;&#20998;&#24037;&#30340;&#20027;&#24373;&#26089;&#26044;&#26412;&#31456;&#21313;&#24180;&#21363;&#24050;&#25552;&#20986;&#12290;</FONT></TD></TR></TABLE>>, tooltip="人機分工的主張早於本章十年即已提出。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n52 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21839;&#38988;&#36681;&#25563;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20998;&#24037;&#21839;&#38988;&#33287;&#23384;&#22312;&#24418;&#24335;&#21839;&#38988;&#26159;&#20841;&#20491;&#19981;&#21516;&#30340;&#21839;&#38988;，&#24460;&#32773;&#26159;&#21069;&#32773;&#30340;&#20808;&#27770;&#26781;&#20214;&#12290;</FONT></TD></TR></TABLE>>, tooltip="分工問題與存在形式問題是兩個不同的問題，後者是前者的先決條件。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}



