 labelloc = "b";

  n13 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#26412;&#31456;&#20027;&#24373;&#30340;&#19981;&#21516;&#20043;&#34389;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26412;&#31456;&#19981;&#20027;&#24373;&#x20;AI&#x20;&#20195;&#26367;&#20154;&#20570;&#23436;&#25972;&#22871;&#23526;&#35657;&#24037;&#20316;；&#26412;&#31456;&#20027;&#24373;&#x20;AI<BR/>&#x20;&#24050;&#38477;&#20302;&#37096;&#20998;&#24037;&#31243;&#29986;&#29289;&#30340;&#35069;&#20316;&#36000;&#25812;，&#22240;&#27492;&#25033;&#30452;&#25509;&#28204;&#37327;&#23436;&#25972;&#30740;&#31350;&#29872;&#22659;&#30340;&#26597;&#37679;&#12289;&#20877;&#29694;&#33287;&#32317;&#25104;&#26412;，<BR/>&#20006;&#25818;&#27492;&#21028;&#26039;&#23427;&#33021;&#21542;&#25104;&#28858;&#27161;&#28310;&#20570;&#27861;&#12290;</FONT></TD></TR></TABLE>>, tooltip="本章不主張 AI 代替人做完整套實證工作；本章主張 AI 已降低部分工程產物的製作負擔，因此應直接測量完整研究環境的查錯、再現與總成本，並據此判斷它能否成為標準做法。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n14 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20998;&#24037;&#21644;&#21487;&#26597;&#26680;&#26159;&#20841;&#20491;&#21839;&#38988;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#12300;&#30001;&#35504;&#22519;&#34892;&#12301;&#33287;&#12300;&#23436;&#25104;&#24460;&#33021;&#21542;&#25214;&#21040;&#12289;&#26680;&#23565;&#20006;&#20877;&#29694;&#12301;&#26159;&#20841;&#20491;&#21839;&#38988;，&#24460;&#32773;&#19981;&#22240;&#24037;&#20316;&#20132;&#32102;&#x20;AI<BR/>&#x20;&#23601;&#33258;&#21205;&#35299;&#27770;&#12290;</FONT></TD></TR></TABLE>>, tooltip="「由誰執行」與「完成後能否找到、核對並再現」是兩個問題，後者不因工作交給 AI 就自動解決。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n51 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20808;&#39493;&#25991;&#29563;&#21453;&#39361;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20154;&#27231;&#20998;&#24037;&#30340;&#20027;&#24373;&#26089;&#26044;&#26412;&#31456;&#21313;&#24180;&#21363;&#24050;&#25552;&#20986;&#12290;</FONT></TD></TR></TABLE>>, tooltip="人機分工的主張早於本章十年即已提出。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n52 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20808;&#21839;&#24590;&#40636;&#26597;&#20877;&#21839;&#20132;&#32102;&#35504;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27770;&#23450;&#19968;&#38917;&#24037;&#20316;&#30001;&#20154;&#25110;&#27231;&#22120;&#22519;&#34892;&#20043;&#21069;，&#25033;&#20808;&#30906;&#20445;&#23427;&#23436;&#25104;&#24460;&#25214;&#24471;&#21040;&#12289;&#23565;&#24471;&#19978;，&#20063;&#33021;&#20877;&#29694;&#12290;</FONT></TD></TR></TABLE>>, tooltip="決定一項工作由人或機器執行之前，應先確保它完成後找得到、對得上，也能再現。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}



