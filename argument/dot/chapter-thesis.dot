subgraph cluster_1 {
  label = <<FONT FACE="arial" POINT-SIZE="12" COLOR="#000000">&#19968;&#12289;&#34987;&#39361;&#26021;&#30340;&#21407;&#22987;&#21629;&#38988;</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "b";

  n0 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20154;&#23569;&#21363;&#24503;&#24615;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20154;&#30340;&#20171;&#20837;&#36234;&#23569;，&#31995;&#32113;&#24615;&#22238;&#39015;&#23601;&#36234;&#19981;&#26371;&#x20;cherry-pick&#12290;</FONT></TD></TR></TABLE>>, tooltip="人的介入越少，系統性回顧就越不會 cherry-pick。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n15 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#36984;&#25799;&#24615;&#22577;&#21578;&#19981;&#21487;&#33258;&#21205;&#21270;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#33258;&#21205;&#21270;&#22312;&#20559;&#35492;&#20597;&#28204;&#30340;&#38364;&#37749;&#38936;&#22495;&#23526;&#28204;&#31561;&#21516;&#20098;&#29468;&#12290;</FONT></TD></TR></TABLE>>, tooltip="自動化在偏誤偵測的關鍵領域實測等同亂猜。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n16 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#33258;&#25105;&#24685;&#32173;&#36852;&#22280;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#30001;&#21516;&#26063;&#27169;&#22411;&#31293;&#26680;&#33258;&#36523;&#29986;&#20986;&#30340;&#36852;&#22280;，&#20854;&#36890;&#36942;&#29575;&#19981;&#26159;&#21697;&#36074;&#25351;&#27161;&#12290;</FONT></TD></TR></TABLE>>, tooltip="由同族模型稽核自身產出的迴圈，其通過率不是品質指標。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n17 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#27231;&#27083;&#20849;&#35672;&#21453;&#23565;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#29694;&#34892;&#35657;&#25818;&#21512;&#25104;&#30340;&#27231;&#27083;&#20849;&#35672;&#26126;&#25991;&#35201;&#27714;&#20154;&#24037;&#30435;&#30563;&#12290;</FONT></TD></TR></TABLE>>, tooltip="現行證據合成的機構共識明文要求人工監督。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n18 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#38334;&#20540;&#21363;&#20559;&#35492;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#33258;&#21205;&#21270;&#27969;&#31243;&#30340;&#32013;&#20837;&#26781;&#20214;&#26412;&#36523;&#23601;&#26159;&#34987;&#20154;&#35373;&#23450;&#30340;&#25361;&#36984;&#35215;&#21063;&#12290;</FONT></TD></TR></TABLE>>, tooltip="自動化流程的納入條件本身就是被人設定的挑選規則。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n19 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#39636;&#21147;&#33258;&#30001;&#24230;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20154;&#20570;&#24471;&#36234;&#22810;，&#20986;&#37679;&#33287;&#25361;&#36984;&#30340;&#27231;&#26371;&#36234;&#22810;&#12290;</FONT></TD></TR></TABLE>>, tooltip="人做得越多，出錯與挑選的機會越多。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}


subgraph cluster_2 {
  label = <<FONT FACE="arial" POINT-SIZE="12" COLOR="#000000">&#20108;&#12289;&#34987;&#25505;&#32013;&#30340;&#20027;&#21629;&#38988;</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "b";

  n1 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>AI&#19981;&#26371;&#21462;&#20195;&#23526;&#35657;&#24037;&#20316;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">AI<BR/>&#x20;&#21487;&#20197;&#21332;&#21161;&#22519;&#34892;&#35657;&#25818;&#21512;&#25104;，&#19981;&#33021;&#20195;&#26367;&#20154;&#23436;&#25104;&#25152;&#26377;&#26041;&#27861;&#21028;&#26039;；&#23427;&#36611;&#21487;&#38752;&#30340;&#36002;&#29563;，&#26159;&#35731;&#30740;&#31350;&#27493;&#39519;<BR/>&#30041;&#19979;&#21487;&#26597;&#12289;&#21487;&#27604;&#23565;&#12289;&#21487;&#20877;&#29694;&#30340;&#29872;&#22659;&#12290;</FONT></TD></TR></TABLE>>, tooltip="AI 可以協助執行證據合成，不能代替人完成所有方法判斷；它較可靠的貢獻，是讓研究步驟留下可查、可比對、可再現的環境。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n2 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20154;&#39006;&#33258;&#30001;&#24230;&#26159;&#20559;&#35492;&#20358;&#28304;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20659;&#32113;&#31995;&#32113;&#24615;&#22238;&#39015;&#30340;&#20559;&#35492;，&#26377;&#19968;&#37096;&#20998;&#28304;&#26044;&#26410;&#34987;&#20107;&#21069;&#32004;&#26463;&#30340;&#20154;&#39006;&#27770;&#31574;&#33258;&#30001;&#24230;&#12290;</FONT></TD></TR></TABLE>>, tooltip="傳統系統性回顧的偏誤，有一部分源於未被事前約束的人類決策自由度。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n3 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20154;&#39006;&#37679;&#35492;&#22522;&#28310;&#32218;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#35413;&#21028;&#33258;&#21205;&#21270;&#26041;&#27861;&#30340;&#38272;&#27323;，&#25033;&#20197;&#20154;&#39006;&#22312;&#30456;&#21516;&#20219;&#21209;&#19978;&#30340;&#23526;&#28204;&#37679;&#35492;&#29575;&#28858;&#22522;&#28310;，&#32780;&#38750;&#20197;&#23436;&#32654;&#28858;&#22522;&#28310;&#12290;</FONT></TD></TR></TABLE>>, tooltip="評判自動化方法的門檻，應以人類在相同任務上的實測錯誤率為基準，而非以完美為基準。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n4 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#33258;&#30001;&#24230;&#19981;&#26371;&#28040;&#22833;，&#21482;&#26371;&#25913;&#35722;&#36617;&#39636;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27770;&#31574;&#33258;&#30001;&#24230;&#21487;&#34987;&#25644;&#31227;，&#19981;&#21487;&#34987;&#28040;&#28357;&#12290;</FONT></TD></TR></TABLE>>, tooltip="決策自由度可被搬移，不可被消滅。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n20 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#30740;&#31350;&#27493;&#39519;&#30041;&#19979;&#21487;&#26597;&#32000;&#37636;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#23531;&#25104;&#27284;&#26696;&#30340;&#27770;&#23450;&#21487;&#20197;&#34987;&#31532;&#19977;&#26041;&#25214;&#21040;&#12289;&#27604;&#23565;&#33287;&#36074;&#30097;，&#34255;&#22312;&#35352;&#25014;&#35041;&#30340;&#27770;&#23450;&#19981;&#34892;&#12290;</FONT></TD></TR></TABLE>>, tooltip="寫成檔案的決定可以被第三方找到、比對與質疑，藏在記憶裡的決定不行。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n21 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>AI&#25509;&#25163;&#24460;&#21028;&#26039;&#20173;&#22312;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#25226;&#24037;&#20316;&#20132;&#32102;&#27169;&#22411;&#20006;&#26410;&#28040;&#38500;&#21028;&#26039;，&#21482;&#26159;&#25226;&#21028;&#26039;&#31227;&#21040;&#25552;&#31034;&#35422;&#12289;&#21443;&#25976;&#33287;&#38272;&#27323;&#12290;</FONT></TD></TR></TABLE>>, tooltip="把工作交給模型並未消除判斷，只是把判斷移到提示詞、參數與門檻。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n22 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21482;&#30475;&#35542;&#25991;&#28961;&#27861;&#26597;&#27969;&#31243;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#29694;&#34892;&#22577;&#21578;&#24037;&#20855;&#20027;&#35201;&#27298;&#26597;&#26368;&#24460;&#23531;&#20986;&#30340;&#35542;&#25991;，&#28961;&#27861;&#21934;&#38752;&#25955;&#25991;&#26680;&#23565;&#35373;&#23450;&#27284;&#12289;&#25552;&#31034;&#35422;&#33287;&#27169;&#22411;&#21443;&#25976;&#12290;</FONT></TD></TR></TABLE>>, tooltip="現行報告工具主要檢查最後寫出的論文，無法單靠散文核對設定檔、提示詞與模型參數。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n23 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#27169;&#22411;&#37325;&#36305;&#19981;&#26371;&#36880;&#23383;&#30456;&#21516;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#35486;&#35328;&#27169;&#22411;&#30340;&#36664;&#20986;&#26410;&#24517;&#36880;&#23383;&#37325;&#29694;，&#22240;&#27492;&#25972;&#26781;&#27969;&#31243;&#19981;&#33021;&#19968;&#27010;&#23459;&#31281;&#26371;&#24471;&#21040;&#30456;&#21516;&#32080;&#26524;&#12290;</FONT></TD></TR></TABLE>>, tooltip="語言模型的輸出未必逐字重現，因此整條流程不能一概宣稱會得到相同結果。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n24 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#26377;&#32000;&#37636;&#19981;&#31561;&#26044;&#32000;&#37636;&#23436;&#25972;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27770;&#23450;&#34987;&#23531;&#25104;&#27284;&#26696;，&#19981;&#20445;&#35657;&#25152;&#26377;&#37325;&#35201;&#27770;&#23450;&#37117;&#24050;&#30041;&#19979;&#12290;</FONT></TD></TR></TABLE>>, tooltip="決定被寫成檔案，不保證所有重要決定都已留下。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n25 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#26410;&#32080;&#27083;&#21270;&#33258;&#30001;&#24230;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26410;&#38928;&#20808;&#25351;&#23450;&#30340;&#27770;&#31574;&#40670;&#26371;&#31995;&#32113;&#24615;&#22320;&#20559;&#21521;&#30740;&#31350;&#32773;&#30340;&#20559;&#22909;&#12290;</FONT></TD></TR></TABLE>>, tooltip="未預先指定的決策點會系統性地偏向研究者的偏好。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n26 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21332;&#23450;&#20559;&#38626;&#23526;&#35657;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#31995;&#32113;&#24615;&#22238;&#39015;&#26222;&#36941;&#20559;&#38626;&#20854;&#24050;&#35387;&#20874;&#21332;&#23450;，&#19988;&#24190;&#20046;&#19981;&#35498;&#26126;&#29702;&#30001;&#12290;</FONT></TD></TR></TABLE>>, tooltip="系統性回顧普遍偏離其已註冊協定，且幾乎不說明理由。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n27 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#22810;&#20998;&#26512;&#24107;&#38626;&#25955;&#23526;&#35657;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#30456;&#21516;&#36039;&#26009;&#33287;&#30456;&#21516;&#20551;&#35373;&#20132;&#32102;&#22810;&#32068;&#20998;&#26512;&#32773;，&#26371;&#24471;&#21040;&#36328;&#36234;&#28961;&#25928;&#32218;&#30340;&#38626;&#25955;&#20272;&#35336;&#12290;</FONT></TD></TR></TABLE>>, tooltip="相同資料與相同假設交給多組分析者，會得到跨越無效線的離散估計。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n28 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21028;&#26039;&#19981;&#31561;&#26044;&#33258;&#30001;&#24230;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#32080;&#27083;&#21270;&#21028;&#26039;&#26159;&#26041;&#27861;，&#19981;&#26159;&#33258;&#30001;&#24230;，&#19981;&#25033;&#34987;&#19968;&#20341;&#28040;&#38500;&#12290;</FONT></TD></TR></TABLE>>, tooltip="結構化判斷是方法，不是自由度，不應被一併消除。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n29 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21152;&#20154;&#38477;&#37679;&#21453;&#39361;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#22686;&#21152;&#23529;&#26597;&#20154;&#25976;&#21487;&#39023;&#33879;&#38477;&#20302;&#37679;&#35492;，&#25925;&#21839;&#38988;&#22312;&#20154;&#22826;&#23569;&#32780;&#38750;&#26377;&#20154;&#12290;</FONT></TD></TR></TABLE>>, tooltip="增加審查人數可顯著降低錯誤，故問題在人太少而非有人。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n30 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#32004;&#26463;&#32780;&#38750;&#31227;&#38500;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#19978;&#36848;&#21453;&#39361;&#35657;&#26126;&#30340;&#26159;&#32004;&#26463;&#30340;&#20729;&#20540;，&#32780;&#38750;&#20154;&#25976;&#30340;&#20729;&#20540;&#12290;</FONT></TD></TR></TABLE>>, tooltip="上述反駁證明的是約束的價值，而非人數的價值。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n31 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#38617;&#20154;&#31721;&#36984;&#20173;&#26377;&#19968;&#25104;&#37679;&#35492;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#21363;&#20351;&#38617;&#20154;&#29544;&#31435;&#31721;&#36984;，&#37679;&#35492;&#29575;&#20173;&#22312;&#19968;&#25104;&#37327;&#32026;&#12290;</FONT></TD></TR></TABLE>>, tooltip="即使雙人獨立篩選，錯誤率仍在一成量級。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n32 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#32080;&#27083;&#21270;&#21028;&#26039;&#21487;&#37325;&#29694;&#23526;&#35657;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#32147;&#32080;&#27083;&#21270;&#30340;&#20154;&#39006;&#21028;&#26039;&#20855;&#20633;&#21487;&#25509;&#21463;&#30340;&#37325;&#29694;&#24615;&#12290;</FONT></TD></TR></TABLE>>, tooltip="經結構化的人類判斷具備可接受的重現性。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n33 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#21487;&#20877;&#29694;&#33287;&#30456;&#21516;&#36664;&#20986;&#35201;&#20998;&#38283;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27969;&#31243;&#33021;&#22816;&#37325;&#26032;&#22519;&#34892;，&#19981;&#20195;&#34920;&#27599;&#20491;&#27493;&#39519;&#37117;&#26371;&#29986;&#29983;&#23436;&#20840;&#30456;&#21516;&#30340;&#36664;&#20986;&#12290;</FONT></TD></TR></TABLE>>, tooltip="流程能夠重新執行，不代表每個步驟都會產生完全相同的輸出。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}


subgraph cluster_3 {
  label = <<FONT FACE="arial" POINT-SIZE="12" COLOR="#000000">&#19977;&#12289;&#35215;&#31684;&#24615;&#32080;&#35542;</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "b";

  n5 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#23436;&#25972;&#30740;&#31350;&#29872;&#22659;&#25033;&#25104;&#28858;&#27161;&#28310;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#35657;&#25818;&#21512;&#25104;&#25033;&#20445;&#23384;&#19968;&#22871;&#25214;&#24471;&#21040;&#21407;&#22987;&#36039;&#26009;&#12289;&#23565;&#24471;&#19978;&#27599;&#27425;&#27770;&#23450;&#12289;&#20063;&#33021;&#37325;&#26032;&#22519;&#34892;&#30340;&#30740;&#31350;&#29872;&#22659;；&#33509;&#23427;&#36948;<BR/>&#21040;&#20107;&#21069;&#35373;&#23450;&#30340;&#26597;&#37679;&#33287;&#20877;&#29694;&#38272;&#27323;，&#19988;&#32317;&#25104;&#26412;&#22312;&#21487;&#25509;&#21463;&#31684;&#22285;&#20839;，&#23601;&#25033;&#25104;&#28858;&#27161;&#28310;&#20570;&#27861;&#12290;</FONT></TD></TR></TABLE>>, tooltip="證據合成應保存一套找得到原始資料、對得上每次決定、也能重新執行的研究環境；若它達到事前設定的查錯與再現門檻，且總成本在可接受範圍內，就應成為標準做法。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n6 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#36852;&#22280;&#21487;&#20449;&#24230;&#21028;&#28310;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#19968;&#20491;&#33258;&#21205;&#21270;&#36852;&#22280;&#30340;&#21487;&#20449;&#24230;，&#24517;&#38920;&#21516;&#26178;&#27298;&#26597;&#21028;&#23450;&#32773;&#26159;&#21542;&#29544;&#31435;&#26044;&#29983;&#25104;&#22120;，&#20197;&#21450;&#20572;&#27490;&#35215;&#21063;&#26159;&#21542;&#20107;&#21069;<BR/>&#22266;&#23450;&#12289;&#35722;&#26356;&#26159;&#21542;&#30041;&#30165;；&#21934;&#19968;&#20839;&#29983;&#25110;&#22806;&#29983;&#20998;&#39006;&#19981;&#36275;&#12290;</FONT></TD></TR></TABLE>>, tooltip="一個自動化迴圈的可信度，必須同時檢查判定者是否獨立於生成器，以及停止規則是否事前固定、變更是否留痕；單一內生或外生分類不足。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n34 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>AI&#38477;&#20302;&#37096;&#20998;&#24314;&#32622;&#36000;&#25812;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">agent<BR/>&#x20;&#22519;&#34892;&#24037;&#20316;&#26178;&#26412;&#20358;&#23601;&#26371;&#35712;&#21462;&#36039;&#26009;&#12289;&#35215;&#21063;&#33287;&#24037;&#20855;，&#20063;&#26371;&#29986;&#29983;&#20013;&#38291;&#32080;&#26524;；&#27839;&#27969;&#31243;&#20445;&#23384;&#36889;&#20123;&#26448;&#26009;，<BR/>&#20006;&#20197;&#x20;AI&#x20;&#21332;&#21161;&#24314;&#31435;&#35373;&#23450;&#27284;&#12289;&#28204;&#35430;&#33287;&#37325;&#36305;&#33139;&#26412;，&#21487;&#28187;&#23569;&#24478;&#38646;&#35069;&#20316;&#36889;&#20123;&#29986;&#29289;&#30340;&#24037;&#20316;&#12290;</FONT></TD></TR></TABLE>>, tooltip="agent 執行工作時本來就會讀取資料、規則與工具，也會產生中間結果；沿流程保存這些材料，並以 AI 協助建立設定檔、測試與重跑腳本，可減少從零製作這些產物的工作。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n35 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#38617;&#36600;&#32066;&#27490;&#21028;&#28310;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#36852;&#22280;&#19981;&#26371;&#21482;&#22240;&#20572;&#27490;&#20107;&#20214;&#20301;&#26044;&#27169;&#22411;&#20043;&#22806;&#23601;&#35722;&#24471;&#21487;&#20449;&#12290;</FONT></TD></TR></TABLE>>, tooltip="迴圈不會只因停止事件位於模型之外就變得可信。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}


subgraph cluster_4 {
  label = <<FONT FACE="arial" POINT-SIZE="12" COLOR="#000000">&#22235;&#12289;&#36880;&#27493;&#26597;&#26680;&#12289;&#37327;&#21270;&#33287;&#22810;&#27169;&#22411;&#27604;&#36611;</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "b";

  n7 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#36880;&#27493;&#32000;&#37636;&#20778;&#26044;&#21934;&#31687;&#26041;&#27861;&#27573;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#35657;&#25818;&#21512;&#25104;&#19981;&#33021;&#21482;&#38752;&#26368;&#24460;&#30340;&#26041;&#27861;&#27573;&#20132;&#20195;&#36942;&#31243;；&#37325;&#35201;&#30340;&#36664;&#20837;&#12289;&#27770;&#23450;&#12289;&#35215;&#21063;&#29256;&#26412;&#33287;&#36664;&#20986;&#35201;&#33021;&#36880;&#27493;&#26680;<BR/>&#23565;&#12290;</FONT></TD></TR></TABLE>>, tooltip="證據合成不能只靠最後的方法段交代過程；重要的輸入、決定、規則版本與輸出要能逐步核對。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n8 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#37327;&#21270;&#21462;&#20195;&#23450;&#24615;&#23459;&#31281;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27969;&#31243;&#30340;&#27599;&#19968;&#20491;&#29872;&#31680;&#37117;&#25033;&#22577;&#21578;&#21487;&#27604;&#36611;&#30340;&#37327;&#21270;&#25351;&#27161;&#33287;&#19981;&#30906;&#23450;&#24615;，&#32780;&#38750;&#23450;&#24615;&#24418;&#23481;&#35422;&#12290;</FONT></TD></TR></TABLE>>, tooltip="流程的每一個環節都應報告可比較的量化指標與不確定性，而非定性形容詞。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n9 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#22810;&#27169;&#22411;&#20849;&#35672;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#21028;&#26039;&#22411;&#27493;&#39519;&#25033;&#30001;&#22810;&#20491;&#30064;&#36074;&#27169;&#22411;&#29544;&#31435;&#29986;&#20986;，&#20006;&#22577;&#21578;&#20854;&#19968;&#33268;&#24230;&#33287;&#20998;&#27495;&#40670;&#12290;</FONT></TD></TR></TABLE>>, tooltip="判斷型步驟應由多個異質模型獨立產出，並報告其一致度與分歧點。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n10 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20998;&#27495;&#21363;&#35338;&#34399;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27169;&#22411;&#38291;&#30340;&#20998;&#27495;&#40670;&#25033;&#34987;&#35222;&#28858;&#38656;&#35201;&#20154;&#24037;&#35009;&#27770;&#30340;&#39640;&#33258;&#30001;&#24230;&#27770;&#31574;&#40670;，&#32780;&#38750;&#38656;&#35201;&#34987;&#28040;&#38500;&#30340;&#38620;&#35338;&#12290;</FONT></TD></TR></TABLE>>, tooltip="模型間的分歧點應被視為需要人工裁決的高自由度決策點，而非需要被消除的雜訊。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n11 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#33258;&#30001;&#24230;&#29105;&#40670;&#28165;&#21934;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#22810;&#27169;&#22411;&#27969;&#31243;&#30340;&#20027;&#35201;&#29986;&#20986;&#19981;&#26159;&#20849;&#35672;&#27161;&#31844;，&#32780;&#26159;&#19968;&#20221;&#27161;&#23450;&#26410;&#32080;&#27083;&#21270;&#33258;&#30001;&#24230;&#25152;&#22312;&#30340;&#28165;&#21934;&#12290;</FONT></TD></TR></TABLE>>, tooltip="多模型流程的主要產出不是共識標籤，而是一份標定未結構化自由度所在的清單。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n36 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#26041;&#27861;&#27573;&#28961;&#27861;&#36880;&#27493;&#26680;&#23565;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#33258;&#28982;&#35486;&#35328;&#26041;&#27861;&#27573;&#21487;&#20197;&#35498;&#26126;&#30740;&#31350;，&#19981;&#33021;&#21934;&#29544;&#35657;&#26126;&#27599;&#19968;&#27493;&#30495;&#30340;&#29031;&#25152;&#36848;&#22519;&#34892;&#12290;</FONT></TD></TR></TABLE>>, tooltip="自然語言方法段可以說明研究，不能單獨證明每一步真的照所述執行。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n37 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#36880;&#27493;&#32000;&#37636;&#21487;&#23450;&#20301;&#21839;&#38988;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#28165;&#26970;&#21015;&#20986;&#21069;&#25552;&#12289;&#27770;&#23450;&#33287;&#36039;&#26009;&#20358;&#28304;，&#33021;&#35731;&#26597;&#26680;&#32773;&#25351;&#20986;&#21738;&#19968;&#27493;&#19981;&#25104;&#31435;&#12290;</FONT></TD></TR></TABLE>>, tooltip="清楚列出前提、決定與資料來源，能讓查核者指出哪一步不成立。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n38 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#27969;&#31243;&#35215;&#21063;&#21487;&#33021;&#22739;&#25481;&#33256;&#24202;&#21028;&#26039;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#33256;&#24202;&#25512;&#29702;&#21253;&#21547;&#30149;&#20154;&#33032;&#32097;&#33287;&#20559;&#22909;，&#25226;&#25152;&#26377;&#20107;&#24773;&#37117;&#22739;&#36914;&#22266;&#23450;&#35215;&#21063;&#26371;&#19999;&#22833;&#36039;&#35338;&#12290;</FONT></TD></TR></TABLE>>, tooltip="臨床推理包含病人脈絡與偏好，把所有事情都壓進固定規則會丟失資訊。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n39 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#23436;&#25972;&#29872;&#22659;&#25226;&#26041;&#27861;&#21644;&#32080;&#26524;&#36899;&#36215;&#20358;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#30740;&#31350;&#29872;&#22659;&#33509;&#36899;&#36215;&#27599;&#20491;&#37325;&#35201;&#27770;&#23450;&#33287;&#32080;&#26524;，&#31532;&#19977;&#26041;&#23601;&#33021;&#25351;&#20986;&#21839;&#38988;&#30332;&#29983;&#22312;&#21738;&#19968;&#27493;&#12290;</FONT></TD></TR></TABLE>>, tooltip="研究環境若連起每個重要決定與結果，第三方就能指出問題發生在哪一步。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n40 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#35657;&#25818;&#21512;&#25104;&#21644;&#24202;&#37002;&#27770;&#31574;&#20998;&#38283;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26412;&#35542;&#35657;&#35201;&#27714;&#35657;&#25818;&#21512;&#25104;&#30340;&#30740;&#31350;&#27969;&#31243;&#21487;&#26597;，&#19981;&#35201;&#27714;&#22266;&#23450;&#35215;&#21063;&#21462;&#20195;&#20491;&#21029;&#30149;&#20154;&#30340;&#33256;&#24202;&#27770;&#31574;&#12290;</FONT></TD></TR></TABLE>>, tooltip="本論證要求證據合成的研究流程可查，不要求固定規則取代個別病人的臨床決策。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n41 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#23450;&#24615;&#24418;&#23481;&#35422;&#19981;&#21487;&#27604;&#36611;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#23450;&#24615;&#25551;&#36848;&#28961;&#27861;&#25903;&#25744;&#36328;&#30740;&#31350;&#30340;&#27604;&#36611;&#33287;&#32047;&#31309;&#12290;</FONT></TD></TR></TABLE>>, tooltip="定性描述無法支撐跨研究的比較與累積。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n42 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#25351;&#27161;&#22833;&#25928;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26410;&#32147;&#27231;&#26371;&#26657;&#27491;&#33287;&#39006;&#21029;&#22833;&#34913;&#26657;&#27491;&#30340;&#21407;&#22987;&#28310;&#30906;&#29575;，&#26371;&#31995;&#32113;&#24615;&#39640;&#20272;&#25928;&#33021;&#12290;</FONT></TD></TR></TABLE>>, tooltip="未經機會校正與類別失衡校正的原始準確率，會系統性高估效能。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n43 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#30064;&#36074;&#24615;&#22238;&#24489;&#29544;&#31435;&#24615;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#21516;&#26063;&#27169;&#22411;&#30340;&#37679;&#35492;&#30456;&#38364;，&#30064;&#36074;&#27169;&#22411;&#21487;&#37096;&#20998;&#22238;&#24489;&#21028;&#26039;&#30340;&#29544;&#31435;&#24615;&#12290;</FONT></TD></TR></TABLE>>, tooltip="同族模型的錯誤相關，異質模型可部分回復判斷的獨立性。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n44 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#25972;&#39636;&#20849;&#35672;&#33192;&#33081;&#20605;&#38525;&#24615;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#22810;&#27169;&#22411;&#38598;&#25104;&#25552;&#21319;&#25935;&#24863;&#24230;&#30340;&#21516;&#26178;&#26371;&#33192;&#33081;&#20605;&#38525;&#24615;&#12290;</FONT></TD></TR></TABLE>>, tooltip="多模型集成提升敏感度的同時會膨脹偽陽性。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n45 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20849;&#35672;&#38750;&#30495;&#20540;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#27169;&#22411;&#38291;&#30340;&#19968;&#33268;&#20006;&#19981;&#27083;&#25104;&#27491;&#30906;&#24615;&#30340;&#35657;&#25818;&#12290;</FONT></TD></TR></TABLE>>, tooltip="模型間的一致並不構成正確性的證據。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n46 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20998;&#27495;&#23450;&#20301;&#33258;&#30001;&#24230;&#35542;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#30064;&#36074;&#27169;&#22411;&#30340;&#20998;&#27495;&#26371;&#38598;&#20013;&#22312;&#21028;&#28310;&#26412;&#36523;&#26410;&#34987;&#26126;&#30906;&#25351;&#23450;&#20043;&#34389;&#12290;</FONT></TD></TR></TABLE>>, tooltip="異質模型的分歧會集中在判準本身未被明確指定之處。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n47 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#29105;&#40670;&#28165;&#21934;&#21363;&#31293;&#26680;&#27161;&#30340;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20998;&#27495;&#28165;&#21934;&#27491;&#26159;&#38656;&#35201;&#34987;&#23459;&#21578;&#33287;&#31293;&#26680;&#30340;&#27770;&#31574;&#40670;&#28165;&#21934;&#12290;</FONT></TD></TR></TABLE>>, tooltip="分歧清單正是需要被宣告與稽核的決策點清單。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}


subgraph cluster_5 {
  label = <<FONT FACE="arial" POINT-SIZE="12" COLOR="#000000">&#20116;&#12289;&#33258;&#35657;&#26696;&#20363;</FONT>>;
  color = "#DADADA";
  margin="8" style = filled;
 labelloc = "b";

  n12 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#33258;&#35657;&#26696;&#20363;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#26412;&#26360;&#20316;&#32773;&#33258;&#36523;&#30340;&#27969;&#31243;&#22312;&#20854;&#29983;&#25104;&#31295;&#20214;&#30340;&#26041;&#27861;&#23416;&#27573;&#33853;&#20013;，&#23531;&#20837;&#20102;&#26410;&#26366;&#30332;&#29983;&#30340;&#26041;&#27861;&#23416;&#20107;&#23526;；&#32780;&#35442;&#20107;<BR/>&#23526;&#20043;&#25152;&#20197;&#33021;&#34987;&#22806;&#37096;&#26597;&#20986;，&#21807;&#19968;&#21407;&#22240;&#26159;&#27969;&#31243;&#26412;&#39636;&#20844;&#38283;&#12290;</FONT></TD></TR></TABLE>>, tooltip="本書作者自身的流程在其生成稿件的方法學段落中，寫入了未曾發生的方法學事實；而該事實之所以能被外部查出，唯一原因是流程本體公開。", shape="box",  margin="0.11,0.055", style="filled,rounded,bold", color="#1b9e77", fillcolor="white", labelfontcolor="white", fontcolor="#000000", type="statement-map-node"];
  n48 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#29983;&#25104;&#26041;&#27861;&#23416;&#27573;&#33853;&#30340;&#36896;&#20551;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#23531;&#20316;&#20195;&#29702;&#22312;&#32570;&#20047;&#30495;&#23526;&#27969;&#31243;&#36039;&#35338;&#30340;&#24773;&#27841;&#19979;，&#35036;&#23531;&#20102;&#21512;&#20046;&#39636;&#20363;&#30340;&#26041;&#27861;&#23416;&#25944;&#36848;&#12290;</FONT></TD></TR></TABLE>>, tooltip="寫作代理在缺乏真實流程資訊的情況下，補寫了合乎體例的方法學敘述。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n49 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#20844;&#38283;&#24615;&#20351;&#26597;&#26680;&#21487;&#33021;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#36896;&#20551;&#30340;&#21487;&#26597;&#26680;&#24615;&#20358;&#33258;&#27969;&#31243;&#26412;&#39636;&#30340;&#20844;&#38283;，&#32780;&#38750;&#20358;&#33258;&#29986;&#29289;&#30340;&#24418;&#24335;&#12290;</FONT></TD></TR></TABLE>>, tooltip="造假的可查核性來自流程本體的公開，而非來自產物的形式。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];
  n50 [label=<<TABLE WIDTH="180" ALIGN="CENTER" BORDER="0" CELLSPACING="0"><TR><TD WIDTH="180" ALIGN="TEXT" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000"><B>&#31293;&#26680;&#38281;&#29872;</B></FONT></TD></TR><TR><TD ALIGN="TEXT" WIDTH="180" BALIGN="CENTER"><FONT FACE="arial" POINT-SIZE="10" COLOR="#000000">&#20197;&#38364;&#37749;&#35422;&#28858;&#21028;&#28310;&#12289;&#19988;&#30001;&#21516;&#19968;&#27969;&#31243;&#20379;&#32102;&#20462;&#35036;&#25351;&#20196;&#30340;&#31293;&#26680;，&#20854;&#36890;&#36942;&#29575;&#19981;&#27083;&#25104;&#21512;&#35215;&#35657;&#25818;&#12290;</FONT></TD></TR></TABLE>>, tooltip="以關鍵詞為判準、且由同一流程供給修補指令的稽核，其通過率不構成合規證據。", margin="0.11,0.055", shape="box", style="filled, rounded", fillcolor="#1b9e77", fontcolor="#000000",  type="argument-map-node"];

}


